NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# Supabase local (Docker). En producción se reemplaza por la URL del proyecto alojado.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
# Opcional para verificación SSL estricta en producción.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

JWT_SECRET=reemplace-por-un-secreto-largo-y-aleatorio
JWT_TTL=3600

# Opcional en desarrollo. En producción permite almacenar portadas y PDF
# en buckets privados. Esta clave jamás debe exponerse en el frontend.
# URL local. Complete SUPABASE_SECRET_KEY con el valor mostrado por
# `npm run supabase:status` si desea probar Storage en Docker.
SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SECRET_KEY=
SUPABASE_COVERS_BUCKET=biblioteca-portadas
SUPABASE_DIGITAL_BUCKET=biblioteca-digitales

# Fallback de archivos para desarrollo local.
LOCAL_UPLOADS_DIR=./uploads

# Bootstrap de la primera cuenta administradora.
ADMIN_NAME=Administrador Biblioteca
ADMIN_USER=admin
ADMIN_PASSWORD="Admin#Cambiar2026"

# Cuenta bibliotecaria opcional para pruebas locales. Omita la contraseña en producción.
LIBRARIAN_NAME=Bibliotecaria de Pruebas
LIBRARIAN_USER=bibliotecaria
LIBRARIAN_PASSWORD="Biblioteca#2026"

# Solo para el reemplazo remoto controlado. No lo deje configurado normalmente.
# CONFIRM_REMOTE_REPLACE=BORRAR_REHABILITACION_GAD
