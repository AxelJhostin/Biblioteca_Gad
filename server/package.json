{
  "name": "biblioteca-municipal-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/scripts/migrate.js",
    "db:seed": "node src/scripts/seed.js",
    "test": "node --test --test-concurrency=1 test/**/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-concurrency=1 test/**/*.test.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "bcryptjs": "3.0.2",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "4.21.2",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.0.2",
    "pg": "8.16.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "supertest": "7.1.4"
  },
  "engines": {
    "node": ">=20 <26"
  }
}

